    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "^57.0.12",
    "expo-linking": "~57.0.7",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jotai": "^2.20.3",
    "jotai-family": "^1.1.0",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "twitter-text": "^3.1.0",
    "unified": "^11.0.5",
    "uniwind": "1.5.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@callstack/licenses": "^0.3.2",
    "@oxfmt/binding-darwin-arm64": "^0.66.0",
    "@oxfmt/binding-win32-x64-msvc": "^0.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "^19.2.5",
    "@types/twitter-text": "^3.1.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-preset-expo": "^57.0.7",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eas-cli": "^23.0.0",
    "eas-cli-local-build-plugin": "^23.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  }
}
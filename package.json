{
  "name": "catalyst-native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuilt": "run-s -c bin:*",
    "bin:emoji-gen": "tsx ./bin/emoji-gen.ts",
    "bin:license-list": "tsx ./bin/license-list.ts",
    "run:android": "pnpm run prebuilt && pnpm with-env expo run:android",
    "run:ios": "pnpm run prebuilt && pnpm with-env expo run:ios",
    "run:ios:op": "pnpm run prebuilt && pnpm with-op expo run:ios",
    "run:ios:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:ios",
    "run:android:op": "pnpm run prebuilt && pnpm with-op expo run:android",
    "run:android:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:android",
    "build:production": "pnpm with-env run-s -c build:*:production",
    "build:android:development": "pnpm run prebuilt && eas build --platform android --profile development --local",
    "build:android:preview": "pnpm run prebuilt && eas build --platform android --profile preview --local",
    "build:android:production": "pnpm run prebuilt && eas build --platform android --profile production --local",
    "build:ios:development": "pnpm run prebuilt && eas build --platform ios --profile development --local",
    "build:ios:preview": "pnpm run prebuilt && eas build --platform ios --profile preview --local",
    "build:ios:production": "pnpm run prebuilt && eas build --platform ios --profile production --local",
    "submit:android:preview": "eas submit --platform android --profile preview",
    "submit:android:production": "eas submit --platform android --profile production",
    "submit:ios:preview": "eas submit --platform ios --profile preview",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "lint": "expo lint",
    "expo": "expo",
    "with-env": "dotenv -e .env.local --",
    "with-op": "cross-env FORCE_COLOR=true op run --env-file=./.env --"
  },
  "dependencies": {
    "@expo/dom-webview": "^57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@luccasr73/with-rn-image-crop-picker": "^0.1.5",
    "@natsuneko-laboratory/catalyst-sdk": "1.0.0-alpha.10",
    "@natsuneko-laboratory/fleet-renderer-core": "link:../fleet-renderer/packages/core",
    "@natsuneko-laboratory/fleet-renderer-react-native": "link:../fleet-renderer/packages/react-native",
    "@natsuneko-laboratory/react-native-twitter-text": "^0.1.0",
    "@react-native-async-storage/async-storage": "3.0.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.9.4",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "^8.4.0",
    "@shopify/flash-list": "^2.3.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "expo": "~57.0.2",
    "expo-asset": "^57.0.3",
    "expo-build-properties": "^57.0.3",
    "expo-clipboard": "^57.0.0",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "^57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "^57.0.2",
    "expo-linking": "~57.0.1",
    "expo-media-library": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "jotai": "^2.18.1",
    "jotai-family": "^1.0.2",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-controller": "^1.21.14",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "twitter-text": "^3.1.0",
    "unified": "^11.0.5",
    "uniwind": "^1.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@callstack/licenses": "^0.3.1",
    "@oxfmt/binding-darwin-arm64": "^0.58.0",
    "@oxfmt/binding-win32-x64-msvc": "^0.58.0",
    "@types/node": "26.1.0",
    "@types/react": "latest",
    "@types/twitter-text": "^3.1.10",
    "babel-preset-expo": "^57.0.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eas-cli": "^20.5.1",
    "eas-cli-local-build-plugin": "^20.5.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.58.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "private": true
}

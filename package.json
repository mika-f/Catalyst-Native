{
  "name": "catalyst-native",
  "version": "1.1.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuilt": "run-s -c bin:*",
    "bin:emoji-gen": "tsx ./bin/emoji-gen.ts",
    "bin:license-list": "tsx ./bin/license-list.ts",
    "clean:nix": "rm -rf node_modules && rm -fr $TMPDIR/haste-map-* && rm -fr $TMPDIR/metro-cache",
    "clean:win": "rmdir /s /q node_modules && del %LOCALAPPDATA%/Temp/haste-map-* && del %LOCALAPPDATA%/Temp/metro-cache",
    "run:android": "pnpm run prebuilt && pnpm with-env expo run:android",
    "run:ios": "pnpm run prebuilt && pnpm with-env expo run:ios",
    "run:ios:op": "pnpm run prebuilt && pnpm with-op expo run:ios",
    "run:ios:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:ios",
    "run:android:op": "pnpm run prebuilt && pnpm with-op expo run:android",
    "run:android:op:local": "pnpm run prebuilt && EXPO_PUBLIC_DEV=local pnpm with-op expo run:android",
    "build:production": "pnpm with-op run-s -c build:*:production",
    "build:android:development": "pnpm run prebuilt && eas build --platform android --profile development --local",
    "build:android:preview": "pnpm run prebuilt && eas build --platform android --profile preview --local",
    "build:android:production": "pnpm run prebuilt && eas build --platform android --profile production --local",
    "build:ios:development": "pnpm run prebuilt && eas build --platform ios --profile development --local",
    "build:ios:preview": "pnpm run prebuilt && eas build --platform ios --profile preview --local",
    "build:ios:production": "pnpm run prebuilt && eas build --platform ios --profile production --local",
    "submit:android:preview": "eas submit --platform android --profile preview",
    "submit:android:production": "eas submit --platform android --profile production",
    "submit:ios:preview": "eas submit --platform ios --profile preview",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "store-shots:dev": "vite --config ./assets/store-screenshots/vite.config.ts",
    "store-shots:build": "vite build --config ./assets/store-screenshots/vite.config.ts",
    "store-shots:preview": "vite preview --config ./assets/store-screenshots/vite.config.ts",
    "store-shots:typecheck": "tsc --noEmit -p ./assets/store-screenshots/tsconfig.json",
    "store-shots:export": "pnpm store-shots:build && tsx ./assets/store-screenshots/export.ts",
    "lint": "expo lint",
    "expo": "expo",
    "with-env": "dotenv -e .env.local --",
    "with-op": "cross-env FORCE_COLOR=true op run --env-file=./.env --",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "^57.0.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@luccasr73/with-rn-image-crop-picker": "^0.1.5",
    "@natsuneko-laboratory/catalyst-sdk": "1.0.0-alpha.17",
    "@natsuneko-laboratory/fleet-renderer-core": "^0.2.0",
    "@natsuneko-laboratory/fleet-renderer-react-native": "^0.1.0",
    "@natsuneko-laboratory/memora": "^0.3.0",
    "@natsuneko-laboratory/react-native-twitter-text": "^0.1.0",
    "@natsuneko-laboratory/react-native-webcrypto-digest": "^0.1.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/messaging": "^26.3.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/drawer": "^7.13.6",
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@sentry/react-native": "^8.21.0",
    "@shopify/flash-list": "^2.3.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "expo": "~57.0.15",
    "expo-asset": "^57.0.13",
    "expo-build-properties": "^57.0.13",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-eas-ipad-support": "^1.0.0",
    "expo-file-system": "^57.0.5",

       puts('ENVFILE or add the missing file.')
     end
 
-    raw = File.read(resolved_path)
-
-    raw.split("\n").each_with_object({}) do |line, h|
-      next if line.strip.empty?
-      next if line.match(/^\s*#/)
-
-      m = line.match(dotenv_pattern)
-      if m.nil?
-        abort('Invalid entry in .env file. Please verify your .env file is correctly formatted.')
+    parse_env_file = lambda do |path|
+      File.read(path).split("\n").each_with_object({}) do |line, h|
+        next if line.strip.empty?
+        next if line.match(/^\s*#/)
+
+        m = line.match(dotenv_pattern)
+        if m.nil?
+          abort('Invalid entry in .env file. Please verify your .env file is correctly formatted.')
+        end
+
+        key = m[:key]
+        # Ensure string (in case of empty value) and escape any quotes present in the value.
+        val = m[:val].to_s.gsub('"', '\"')
+        h[key] = val
       end
+    end
 
-      key = m[:key]
-      # Ensure string (in case of empty value) and escape any quotes present in the value.
-      val = m[:val].to_s.gsub('"', '\"')
-      h[key] = val
+    values = parse_env_file.call(resolved_path)
+
+    # A gitignored ".local" sibling of the resolved file (.env -> .env.local,
+    # .env.staging -> .env.staging.local) overrides it, key by key.
+    local_path = "#{resolved_path}.local"
+    if File.exist?(local_path)
+      puts("Merging local overrides from #{local_path}")
+      values.merge!(parse_env_file.call(local_path))
     end
+
+    values
     rescue Errno::ENOENT
       puts('**************************')
       puts('*** Missing .env file ****')
